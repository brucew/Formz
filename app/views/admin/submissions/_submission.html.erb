<tr>
  <td class="font-medium whitespace-nowrap text-slate-900"><%= submission.user.email %></td>
  <td class="whitespace-nowrap"><%= l(submission.created_at, format: :long) %></td>
  <% fields.each do |field| %>
    <td><%= submission.display_value_for(field).presence || "—" %></td>
  <% end %>
</tr>
