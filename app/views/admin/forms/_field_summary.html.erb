<%# Read-only description of one field, shared by the form detail page and the field
    editor of a form that has stopped accepting structural changes. %>
<div class="flex flex-wrap items-start justify-between gap-x-6 gap-y-2">
  <div>
    <h3 class="text-sm font-semibold text-slate-900">
      <span class="text-slate-400"><%= number %>.</span>
      <%= field.label %>
      <% if field.required? %>
        <span class="badge badge-required">Required</span>
      <% end %>
    </h3>
    <% if field.description.present? %>
      <p class="mt-1 prose-muted"><%= field.description %></p>
    <% end %>
    <% if field.choices.any? %>
      <ul class="mt-2 flex flex-wrap gap-2">
        <% field.choices.each do |choice| %>
          <li class="rounded-md bg-slate-100 px-2 py-0.5 text-xs text-slate-700"><%= choice %></li>
        <% end %>
      </ul>
    <% end %>
  </div>

  <p class="whitespace-nowrap text-xs text-slate-500">
    <%= field_input_type_label(field.input_type) %> · stores <%= field.value_type %>
  </p>
</div>
