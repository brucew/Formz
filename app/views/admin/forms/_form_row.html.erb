<%# One row of the wide-screen form table. A deleted form is de-emphasised with a tinted
    row and loses its edit and delete actions; the "Deleted" badge is what actually says
    so, since colour on its own says nothing. %>
<tr class="<%= "bg-slate-50" if form.deleted? %>">
  <td>
    <%= link_to form.name, admin_form_path(form),
                class: "font-medium break-words text-indigo-600 hover:text-indigo-500 focus-visible:underline" %>
    <% if form.description.present? %>
      <p class="mt-1 max-w-md text-slate-500"><%= truncate(form.description, length: 90) %></p>
    <% end %>
  </td>
  <td class="whitespace-nowrap"><%= form.fields.size %></td>
  <td class="whitespace-nowrap"><%= form.submissions.size %></td>
  <td class="whitespace-nowrap"><%= render "form_status", form: form %></td>
  <td>
    <div class="flex flex-wrap items-center justify-end gap-2">
      <%= render "form_actions", form: form %>
    </div>
  </td>
</tr>
