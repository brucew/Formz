<% content_for :title, "Reset your password" %>

<%= render layout: "devise/shared/auth_card",
           locals: { title: "Reset your password",
                     description: "Tell us the email address on your account and we will send you a link to set a new password." } do %>
  <%= form_with model: resource, as: resource_name, url: password_path(resource_name), class: "space-y-6" do |form| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= form.label :email, "Email address", class: "form-label" %>
      <%= form.email_field :email, autofocus: true, autocomplete: "email", required: true,
            class: "form-control", "aria-invalid": resource.errors[:email].any? %>
    </div>

    <%= form.submit "Send reset instructions", class: "btn btn-primary w-full" %>
  <% end %>

  <%= render "devise/shared/links" %>
<% end %>
