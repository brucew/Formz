<%# Confirmable, lockable and omniauthable are not enabled on this app, so the branches
    Devise generates for them are left out rather than kept as unreachable markup. %>
<nav class="mt-8 flex flex-col items-center gap-2 border-t border-slate-200 pt-6" aria-label="Account">
  <% if controller_name != "sessions" %>
    <%= link_to "Sign in", new_session_path(resource_name), class: "btn-link" %>
  <% end %>

  <% if devise_mapping.registerable? && controller_name != "registrations" %>
    <%= link_to "Create an account", new_registration_path(resource_name), class: "btn-link" %>
  <% end %>

  <% if devise_mapping.recoverable? && !controller_name.in?(%w[passwords registrations]) %>
    <%= link_to "Forgot your password?", new_password_path(resource_name), class: "btn-link" %>
  <% end %>
</nav>
