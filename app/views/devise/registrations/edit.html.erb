<% content_for :title, "Account settings" %>

<%= render layout: "devise/shared/auth_card",
           locals: { title: "Account settings", description: "Change the email address or password on your Formz account." } do %>
  <%= form_with model: resource, as: resource_name, url: registration_path(resource_name), method: :put, class: "space-y-6" do |form| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div>
      <%= form.label :email, "Email address", class: "form-label" %>
      <%= form.email_field :email, autofocus: true, autocomplete: "email", required: true, class: "form-control" %>
    </div>

    <div>
      <%= form.label :password, "New password", class: "form-label" %>
      <%= form.password_field :password, autocomplete: "new-password", class: "form-control" %>
      <p class="form-hint">
        Leave blank to keep your current password<%= ", #{@minimum_password_length} characters minimum" if @minimum_password_length %>.
      </p>
    </div>

    <div>
      <%= form.label :password_confirmation, "Confirm new password", class: "form-label" %>
      <%= form.password_field :password_confirmation, autocomplete: "new-password", class: "form-control" %>
    </div>

    <div>
      <%= form.label :current_password, class: "form-label" %>
      <%= form.password_field :current_password, autocomplete: "current-password", required: true, class: "form-control" %>
      <p class="form-hint">We need your current password to confirm these changes.</p>
    </div>

    <div class="flex flex-wrap items-center gap-3">
      <%= form.submit "Save changes", class: "btn btn-primary" %>
      <%= link_to "Back to forms", root_path, class: "btn btn-secondary" %>
    </div>
  <% end %>

  <section class="mt-8 border-t border-slate-200 pt-6">
    <h2 class="text-base font-semibold text-slate-900">Cancel my account</h2>
    <p class="mt-1 prose-muted">
      Cancelling deletes your account and every submission you have made. This cannot be undone.
    </p>
    <%= button_to "Cancel my account", registration_path(resource_name), method: :delete,
                  class: "btn btn-danger mt-4",
                  form_class: "inline-block",
                  data: { turbo_confirm: "Cancel your account? This deletes your account and every submission you have made, and cannot be undone." } %>
  </section>
<% end %>
