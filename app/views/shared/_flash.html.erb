<% if notice.present? %>
  <p class="mb-6 rounded-md bg-emerald-50 px-4 py-3 text-sm text-emerald-800 ring-1 ring-inset ring-emerald-200" role="status">
    <%= notice %>
  </p>
<% end %>

<% if alert.present? %>
  <p class="mb-6 rounded-md bg-red-50 px-4 py-3 text-sm text-red-800 ring-1 ring-inset ring-red-200" role="alert">
    <%= alert %>
  </p>
<% end %>
