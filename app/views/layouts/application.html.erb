<!DOCTYPE html>
<html class="h-full bg-slate-50">
  <head>
    <title><%= content_for(:title) || "Formz" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Formz">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="h-full text-slate-900 antialiased">
    <% if user_signed_in? %>
      <header class="border-b border-slate-200 bg-white">
        <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-3 px-4 py-4 sm:px-6">
          <%= link_to "Formz", root_path, class: "text-lg font-semibold tracking-tight text-slate-900" %>

          <nav class="flex items-center gap-4 text-sm" aria-label="Main">
            <% if current_user.admin? %>
              <%= link_to "My forms", admin_forms_path, class: "font-medium text-slate-600 hover:text-slate-900" %>
            <% end %>
            <%= link_to "All forms", forms_path, class: "font-medium text-slate-600 hover:text-slate-900" %>
          </nav>

          <div class="ml-auto flex items-center gap-3 text-sm">
            <span class="text-slate-500"><%= current_user.email %></span>
            <% if current_user.admin? %>
              <span class="badge badge-admin">Admin</span>
            <% end %>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "btn btn-secondary" %>
          </div>
        </div>
      </header>
    <% end %>

    <main class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
      <%= render "shared/flash" %>
      <%= yield %>
    </main>
  </body>
</html>
